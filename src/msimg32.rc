// Version resource for the 32-bit settings-launcher proxy DLL (msimg32.dll).
// version.rc is generated from the repository's root VERSION file.
#include <windows.h>
#include "version.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_COMMA
 PRODUCTVERSION VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nico Verbruggen"
            VALUE "FileDescription", "Atelier Arland Fixes settings-launcher proxy"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "msimg32"
            VALUE "LegalCopyright", "Nico Verbruggen. MIT and zlib licensed; see LICENSE."
            VALUE "OriginalFilename", "msimg32.dll"
            VALUE "ProductName", "Atelier Arland Fixes"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
