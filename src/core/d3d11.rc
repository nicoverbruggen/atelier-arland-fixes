// Version resource for the 64-bit game DLL (d3d11.dll). version.rc is generated
// from the repository's root VERSION file.
#include <windows.h>
#include "version.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_COMMA
 PRODUCTVERSION VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nico Verbruggen"
            VALUE "FileDescription", "Atelier Arland Fixes (D3D11 proxy)"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "d3d11"
            VALUE "LegalCopyright", "Nico Verbruggen. MIT and zlib licensed; see LICENSE."
            VALUE "OriginalFilename", "d3d11.dll"
            VALUE "ProductName", "Atelier Arland Fixes"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
